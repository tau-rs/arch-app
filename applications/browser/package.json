{
  "private": true,
  "name": "arch-browser-app",
  "version": "0.0.0",
  "description": "arch · Theia browser target: the dev loop and the Playwright target; no native modules",
  "license": "MIT",
  "dependencies": {
    "@tau-rs/arch-shell": "0.0.0",
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start": "theia start --port 3000",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "arch",
        "preferences": { "files.enableTrash": false }
      }
    },
    "backend": {
      "config": { "frontendConnectionTimeout": -1 }
    }
  }
}
